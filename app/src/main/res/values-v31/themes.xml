<?xml version="1.0" encoding="utf-8"?>
<!--
    Só Android 12+ (pasta values-v31): o sistema mostra uma splash própria antes do app.
    Deixamos ela azul e sem ícone, para emendar direto na NOSSA animação.
    Este arquivo substitui o Theme.Guard.Splash do values/themes.xml nessas versões.
-->
<resources>
    <style name="Theme.Guard.Splash" parent="Theme.Guard">
        <item name="android:windowBackground">@color/guard_blue</item>
        <item name="android:statusBarColor">@color/guard_blue</item>
        <item name="android:navigationBarColor">@color/guard_blue</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/guard_blue</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
    </style>
</resources>
