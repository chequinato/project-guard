<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo do botão principal: azul, mais escuro quando pressionado, cinza quando desligado. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/guard_line" />
    <item android:state_pressed="true" android:color="@color/guard_blue_pressed" />
    <item android:color="@color/guard_blue" />
</selector>
