<?xml version="1.0" encoding="utf-8"?>
<!--
    Tela 5 · History ("Your trips"). Código: ui/history/HistoryActivity.java
    As linhas da lista são criadas no Java a partir do item_trip.xml.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/Guard.IconButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Guard.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/your_trips" />

        <TextView
            android:id="@+id/txt_summary"
            style="@style/Guard.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:id="@+id/list_trips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp" />

        <TextView
            android:id="@+id/txt_empty"
            style="@style/Guard.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:text="@string/history_empty"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
