<?xml version="1.0" encoding="utf-8"?>
<!--
    Um bloco de veículo (ícone + nome). Usado 3 vezes na tela inicial com <include>.
    duplicateParentState="true" nos filhos: quando o bloco fica "selected", o ícone e o texto
    também ficam, e trocam de cor sozinhos (color/tile_fg.xml).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="92dp"
    android:background="@drawable/bg_tile"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/tile_icon"
        android:layout_width="38dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:duplicateParentState="true"
        android:tint="@color/tile_fg" />

    <TextView
        android:id="@+id/tile_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:duplicateParentState="true"
        android:maxLines="1"
        android:textColor="@color/tile_fg"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
