<?xml version="1.0" encoding="utf-8"?>
<!--
    Tela 2 · Trip mode (tela escura "Monitoring" do site). Código: ui/trip/TripActivity.java
    Os valores "0", "0.0 g" e "0°/s" são só o começo: a Activity troca a cada leitura.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/guard_navy"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp">

        <!-- Topo: "ao vivo" + veículo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/live_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_live_dot" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/monitoring"
                android:textColor="@color/guard_live"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_vehicle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_chip_dark"
                android:drawablePadding="8dp"
                android:drawableTint="@color/white"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Velocidade grande -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/funnel_display"
                android:includeFontPadding="false"
                android:letterSpacing="-0.04"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="112sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/kmh"
                android:textColor="@color/navy_muted"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_pin"
            android:drawablePadding="6dp"
            android:drawableTint="@color/navy_muted"
            android:gravity="center_vertical"
            android:text="@string/demo_location"
            android:textColor="@color/navy_muted"
            android:textSize="14sp" />

        <!-- Sensores: duas barras + os 4 sinais -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/impact"
                    android:textColor="@color/white"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/txt_impact"
                    style="@style/Guard.Data"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0 g"
                    android:textColor="@color/white" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/bar_impact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="100"
                app:indicatorColor="@color/guard_blue_light"
                app:trackColor="@color/navy_line"
                app:trackCornerRadius="4dp"
                app:trackThickness="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/rotation"
                    android:textColor="@color/white"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/txt_rotation"
                    style="@style/Guard.Data"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0°/s"
                    android:textColor="@color/white" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/bar_rotation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="100"
                app:indicatorColor="@color/guard_blue_light"
                app:trackColor="@color/navy_line"
                app:trackCornerRadius="4dp"
                app:trackThickness="8dp" />

            <!-- Os 4 sinais: acendem (setActivated) quando o detector dispara -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">
                <TextView android:id="@+id/sig_impact" style="@style/Guard.Signal"
                    android:layout_marginEnd="8dp"
                    android:drawableStart="@drawable/ic_impact" android:text="@string/impact" />
                <TextView android:id="@+id/sig_drop" style="@style/Guard.Signal"
                    android:drawableStart="@drawable/ic_speed" android:text="@string/speed_drop" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <TextView android:id="@+id/sig_rotation" style="@style/Guard.Signal"
                    android:layout_marginEnd="8dp"
                    android:drawableStart="@drawable/ic_rotation" android:text="@string/rotation" />
                <TextView android:id="@+id/sig_still" style="@style/Guard.Signal"
                    android:drawableStart="@drawable/ic_still" android:text="@string/stillness" />
            </LinearLayout>
        </LinearLayout>

        <!-- Demo: botões que tocam os cenários do simulador (criados no Java) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/demo_title"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/group_scenarios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="8dp" />

        <TextView
            android:id="@+id/txt_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_bubble_dark"
            android:lineSpacingMultiplier="1.15"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:text="@string/trip_status_idle"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_end"
            style="@style/Guard.Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/end_trip"
            android:textColor="@color/white"
            app:strokeColor="@color/white_60" />
    </LinearLayout>
</ScrollView>
