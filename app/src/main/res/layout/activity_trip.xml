<?xml version="1.0" encoding="utf-8"?>
<!-- Tela 2 · Trip mode (tela escura "Monitoring" do site) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/guard_navy"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_live_dot" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="@string/monitoring"
                android:textAllCaps="true"
                android:textColor="@color/guard_live"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txt_vehicle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textAllCaps="true"
                android:textColor="@color/white_60"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Velocidade grande -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="88sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/kmh"
                android:textColor="@color/white_60"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_where"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jundiaí, SP"
            android:textColor="@color/white_60" />

        <!-- Barras de impacto e rotação -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/impact"
                    android:textColor="@color/white" />
                <TextView
                    android:id="@+id/txt_impact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="0.0 g"
                    android:textColor="@color/white" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/bar_impact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="100"
                app:indicatorColor="@color/guard_blue_light"
                app:trackColor="@color/white_15"
                app:trackCornerRadius="4dp"
                app:trackThickness="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/rotation"
                    android:textColor="@color/white" />
                <TextView
                    android:id="@+id/txt_rotation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="0°/s"
                    android:textColor="@color/white" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/bar_rotation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="100"
                app:indicatorColor="@color/guard_blue_light"
                app:trackColor="@color/white_15"
                app:trackCornerRadius="4dp"
                app:trackThickness="8dp" />

            <!-- Os 4 sinais: acendem quando o detector dispara -->
            <TextView
                android:id="@+id/txt_signals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="monospace"
                android:textColor="@color/white_60"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Demo: botões que tocam os cenários do simulador -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="monospace"
            android:text="@string/demo_title"
            android:textAllCaps="true"
            android:textColor="@color/white_60"
            android:textSize="12sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/group_scenarios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/txt_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_dark"
            android:padding="14dp"
            android:text="Riding normally. Pick a situation above to test the detector."
            android:textColor="@color/white" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <Button
            android:id="@+id/btn_end"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/end_trip"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:cornerRadius="16dp"
            app:strokeColor="@color/white_60" />
    </LinearLayout>
</ScrollView>
