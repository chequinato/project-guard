<?xml version="1.0" encoding="utf-8"?>
<!--
    Tela 3 · Are you OK? / alerta. Código: ui/alert/AlertActivity.java
    FrameLayout empilha os filhos. Temos 3 painéis e só um fica visível por vez:
    panel_count (contagem) -> panel_alert (alerta enviado) -> panel_end (final).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/guard_alert_dark"
    android:fitsSystemWindows="true">

    <!-- ===== Painel 1: contagem regressiva ===== -->
    <LinearLayout
        android:id="@+id/panel_count"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_alert"
            android:drawablePadding="8dp"
            android:drawableTint="@color/white"
            android:gravity="center_vertical"
            android:text="@string/possible_accident"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Guard.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/are_you_ok"
            android:textColor="@color/white"
            android:textSize="50sp" />

        <!-- Anel da contagem + halo que pulsa atrás -->
        <FrameLayout
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_marginTop="24dp">

            <View
                android:id="@+id/halo"
                android:layout_width="210dp"
                android:layout_height="210dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pulse" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/ring"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:max="1000"
                android:progress="1000"
                app:indicatorColor="@color/white"
                app:indicatorSize="210dp"
                app:trackColor="@color/white_15"
                app:trackCornerRadius="6dp"
                app:trackThickness="12dp" />

            <TextView
                android:id="@+id/txt_seconds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/funnel_display"
                android:letterSpacing="-0.04"
                android:text="15"
                android:textColor="@color/white"
                android:textSize="84sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/txt_who"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/white"
            android:textSize="17sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ok"
            style="@style/Guard.Button"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:text="@string/im_ok"
            android:textColor="@color/guard_alert_deep"
            android:textSize="24sp"
            app:backgroundTint="@color/white"
            app:cornerRadius="24dp"
            app:rippleColor="#33DE3F0B" />
    </LinearLayout>

    <!-- ===== Painel 2: alerta enviado + fila de contatos ===== -->
    <ScrollView
        android:id="@+id/panel_alert"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_send"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/white"
                    android:gravity="center_vertical"
                    android:text="@string/alert_sent"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <View
                    android:id="@+id/live_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_end_icon" />
                <TextView
                    android:id="@+id/txt_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/live_location"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_alert_title"
                style="@style/Guard.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/txt_alert_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/white_80"
                android:textSize="15sp" />

            <!-- Espera pela resposta do contato: esvazia em 15 s; vazia = vai para o próximo -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/bar_wait"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:max="1000"
                android:progress="1000"
                app:indicatorColor="@color/white"
                app:trackColor="@color/white_15"
                app:trackCornerRadius="3dp"
                app:trackThickness="6dp" />

            <!-- Prévia do que o contato recebe: parece uma notificação de celular -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_notification"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_guard_logo" />
                    <TextView
                        android:id="@+id/txt_channel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/notif_header"
                        android:textColor="@color/guard_muted"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <TextView
                    android:id="@+id/txt_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingMultiplier="1.15"
                    android:textColor="@color/guard_ink"
                    android:textSize="14sp" />
                <!-- Status do envio: "Enviando SMS...", "SMS enviado" ou "falhou" (o Java preenche) -->
                <TextView
                    android:id="@+id/txt_sms_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/guard_muted"
                    android:textSize="13sp" />
                <!-- Plano B: se o SMS automático falhar (ou estiver em modo demo), abre o app de
                     mensagens do celular com o texto e o número prontos. Só aparece quando precisa. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sms_app"
                    style="@style/Guard.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="48dp"
                    android:text="@string/send_via_sms_app"
                    android:textColor="@color/guard_accent"
                    android:textSize="15sp"
                    android:visibility="gone"
                    app:icon="@drawable/ic_send"
                    app:iconGravity="textStart"
                    app:iconSize="18dp"
                    app:iconTint="@color/guard_accent"
                    app:strokeColor="@color/guard_accent" />
            </LinearLayout>

            <!-- Fila do escalonamento: quem já foi avisado, quem é o próximo (o Java preenche) -->
            <LinearLayout
                android:id="@+id/list_queue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_queue"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirmed"
                style="@style/Guard.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/contact_confirmed"
                android:textColor="@color/guard_alert_deep"
                app:backgroundTint="@color/white"
                app:rippleColor="#33DE3F0B" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel_alert"
                style="@style/Guard.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/cancel_alert"
                android:textColor="@color/white"
                app:strokeColor="@color/white" />
        </LinearLayout>
    </ScrollView>

    <!-- ===== Painel 3: final (cancelado, socorro a caminho ou sem resposta) ===== -->
    <LinearLayout
        android:id="@+id/panel_end"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.6" />

        <ImageView
            android:id="@+id/img_end"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/bg_end_icon"
            android:contentDescription="@null"
            android:padding="22dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/txt_end_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_end_title"
            style="@style/Guard.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/txt_end_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingMultiplier="1.15"
            android:textSize="16sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            style="@style/Guard.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/back_to_trip" />
    </LinearLayout>
</FrameLayout>
