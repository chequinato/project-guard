<?xml version="1.0" encoding="utf-8"?>
<!--
    Tela 1 · New trip. Código: ui/home/MainActivity.java

    COMO LER UM LAYOUT (vale para todas as telas):
    - Cada <Tag> é um componente: TextView (texto), ImageView (imagem), Button...
    - Containers guardam outros componentes:
        ScrollView   -> deixa rolar quando o conteúdo não cabe
        LinearLayout -> empilha os filhos em linha (horizontal) ou coluna (vertical)
    - layout_width / layout_height:
        match_parent = ocupa todo o espaço do pai | wrap_content = só o tamanho do conteúdo
        0dp + layout_weight="1" = "divide o espaço que sobrar"
    - dp para tamanhos; sp para texto (respeita o tamanho de fonte escolhido pelo usuário).
    - android:id="@+id/nome" cria um id; no Java: findViewById(R.id.nome).
    - @string, @color, @drawable, @style e @font apontam para arquivos em res/.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <!-- Topo: logo + nome + botão do histórico -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_guard_logo" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/funnel_display"
                android:letterSpacing="-0.03"
                android:text="@string/brand_wordmark"
                android:textColor="@color/guard_ink"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Idioma: bandeira do idioma para o qual vai trocar (o Java escolhe BR ou US).
                 Sem o estilo IconButton porque ele pinta o ícone de uma cor só (tint). -->
            <ImageButton
                android:id="@+id/btn_language"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/change_language"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_flag_br" />

            <ImageButton
                android:id="@+id/btn_history"
                style="@style/Guard.IconButton"
                android:contentDescription="@string/history"
                android:src="@drawable/ic_history" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_title"
            style="@style/Guard.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/ready_title" />

        <TextView
            style="@style/Guard.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/home_subtitle" />

        <!-- Veículo: 3 blocos; o Java marca o escolhido com setSelected(true) -->
        <TextView
            style="@style/Guard.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/vehicle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <include
                android:id="@+id/btn_car"
                layout="@layout/item_vehicle_tile"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/btn_moto"
                layout="@layout/item_vehicle_tile"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/btn_bike"
                layout="@layout/item_vehicle_tile"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Limites do veículo escolhido: valor (DM Mono) + o que significa -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/txt_limit_impact"
                    style="@style/Guard.Data"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/limit_impact_label"
                    android:textColor="@color/guard_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/txt_limit_drop"
                    style="@style/Guard.Data"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/limit_drop_label"
                    android:textColor="@color/guard_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/txt_limit_rotation"
                    style="@style/Guard.Data"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/limit_rotation_label"
                    android:textColor="@color/guard_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Contatos: título + botão Edit -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Guard.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/alert_order" />

            <TextView
                android:id="@+id/btn_edit_contacts"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_row"
                android:drawableStart="@drawable/ic_edit"
                android:drawablePadding="6dp"
                android:drawableTint="@color/guard_blue"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:text="@string/edit"
                android:textColor="@color/guard_blue"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Um cartão só, com uma linha por contato (o Java preenche) -->
        <LinearLayout
            android:id="@+id/list_contacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp" />

        <TextView
            android:id="@+id/txt_no_contacts"
            style="@style/Guard.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:text="@string/no_contacts"
            android:visibility="gone" />

        <!-- Space com weight=1 "empurra" o botão para o fim da tela -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="28dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start"
            style="@style/Guard.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/start_trip"
            app:icon="@drawable/ic_start" />
    </LinearLayout>
</ScrollView>
