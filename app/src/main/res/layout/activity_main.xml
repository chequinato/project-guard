<?xml version="1.0" encoding="utf-8"?>
<!--
    Tela 1 · New trip. Código: ui/home/MainActivity.java

    COMO LER UM LAYOUT (vale para todas as telas):
    - Cada <Tag> é um componente: TextView (texto), Button, ImageView (imagem), EditText (campo)...
    - Componentes que guardam outros dentro são "containers":
        ScrollView   -> deixa rolar a tela quando o conteúdo não cabe
        LinearLayout -> empilha os filhos em linha (horizontal) ou coluna (vertical)
    - android:layout_width / layout_height:
        match_parent = ocupa todo o espaço do pai
        wrap_content = só o tamanho do próprio conteúdo
        0dp + layout_weight="1" = "divide o espaço que sobrar"
    - Unidades: dp para tamanhos e espaços; sp para texto (respeita o tamanho de fonte do usuário).
    - android:id="@+id/nome" cria um id; no Java usamos findViewById(R.id.nome).
    - @string/x, @color/x, @drawable/x, @style/x apontam para arquivos em res/values e res/drawable.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Topo: logo + nome + atalho para o histórico (linha horizontal) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_guard_logo" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/guard_ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/history"
                android:textColor="@color/guard_blue"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            style="@style/Guard.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/new_trip" />

        <TextView
            android:id="@+id/txt_title"
            style="@style/Guard.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/ready_title" />

        <!-- Veículo: grupo de 3 botões em que só um fica marcado (singleSelection) -->
        <TextView
            style="@style/Guard.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/vehicle" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/group_vehicle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/btn_car"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/car"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingHorizontal="2dp"
                android:textSize="13sp"
                android:maxLines="1"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_moto"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/motorcycle"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingHorizontal="2dp"
                android:textSize="13sp"
                android:maxLines="1"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_bike"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/bicycle"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingHorizontal="2dp"
                android:textSize="13sp"
                android:maxLines="1"
                android:textAllCaps="false" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Limites do veículo escolhido; o texto é preenchido no Java -->
        <TextView
            android:id="@+id/txt_limits"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textColor="@color/guard_muted"
            android:textSize="12sp" />

        <!-- Ordem de alerta: as linhas de contato são adicionadas pelo Java dentro de list_contacts -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Guard.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/alert_order" />

            <TextView
                android:id="@+id/btn_edit_contacts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/edit"
                android:textColor="@color/guard_blue"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/list_contacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/txt_no_contacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:text="@string/no_contacts"
            android:textColor="@color/guard_muted"
            android:visibility="gone" />

        <!-- Space com weight=1 "empurra" o botão para o fim da tela -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <Button
            android:id="@+id/btn_start"
            style="@style/Guard.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/start_trip" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/slogan"
            android:textColor="@color/guard_muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
