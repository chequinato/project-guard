<?xml version="1.0" encoding="utf-8"?>
<!--
    Tela 0 · Abertura animada (uns 2 segundos). Código: ui/splash/SplashActivity.java
    Tudo começa invisível ou pequeno; o Java anima cada peça na ordem certa.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/guard_blue">

    <!-- Bloco central: logo + nome + slogan -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- FrameLayout empilha: o pulso fica ATRÁS do logo -->
        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="220dp">

            <View
                android:id="@+id/pulse"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/bg_pulse" />

            <ImageView
                android:id="@+id/logo"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:contentDescription="@string/app_name"
                android:src="@drawable/avd_guard_logo" />
        </FrameLayout>

        <TextView
            android:id="@+id/txt_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:letterSpacing="-0.02"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="48sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_slogan"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0"
            android:gravity="center"
            android:text="@string/slogan"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Rodapé discreto -->
    <TextView
        android:id="@+id/txt_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:alpha="0"
        android:fontFamily="monospace"
        android:letterSpacing="0.06"
        android:text="@string/splash_footer"
        android:textAllCaps="true"
        android:textColor="@color/white_60"
        android:textSize="12sp" />
</FrameLayout>
