<?xml version="1.0" encoding="utf-8"?>
<!--
    Tela 0 · Abertura animada. Código: ui/splash/SplashActivity.java
    O logo se monta sozinho (avd_guard_splash.xml); o Java anima o nome e o slogan
    e, no fim, um círculo claro cresce a partir do logo e "abre" o app.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/guard_blue">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- FrameLayout empilha: o pulso fica ATRÁS do logo -->
        <FrameLayout
            android:layout_width="200dp"
            android:layout_height="200dp">

            <View
                android:id="@+id/pulse"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/bg_pulse" />

            <ImageView
                android:id="@+id/logo"
                android:layout_width="118dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/avd_guard_splash" />
        </FrameLayout>

        <!-- "guard" em minúsculas, igual ao cabeçalho do site -->
        <TextView
            android:id="@+id/txt_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:fontFamily="@font/funnel_display"
            android:letterSpacing="-0.04"
            android:text="@string/brand_wordmark"
            android:textColor="@color/white"
            android:textSize="56sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_slogan"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/slogan"
            android:textColor="@color/white_80"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Camada clara que cresce em círculo no final, revelando o app -->
    <View
        android:id="@+id/reveal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/guard_page"
        android:visibility="invisible" />
</FrameLayout>
